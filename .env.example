# Copy this file to .env and fill in the values. Never commit .env.

# Hyperswitch Control Center -> Developers -> Keys
# Secret API key (snd_...). Server only.
HYPERSWITCH_API_KEY=
# Publishable key (pk_snd_...). Sent to the browser for the checkout SDK.
HYPERSWITCH_PUBLISHABLE_KEY=

# Developers -> Payment Settings -> your profile -> payment response hash key.
# Used to verify the x-webhook-signature-512 header on incoming webhooks.
HYPERSWITCH_WEBHOOK_SECRET=

# Optional: only if you have more than one business profile.
HYPERSWITCH_PROFILE_ID=

HYPERSWITCH_BASE_URL=https://sandbox.hyperswitch.io

# Where the browser is sent back after a redirect (3DS, wallets).
# Dev: the Vite URL. Production: your deployed URL.
APP_BASE_URL=http://localhost:5173

PORT=3001

# Optional locally; required on Render. Neon Postgres connection string.
# Without it, orders are stored in data/store.json.
DATABASE_URL=
